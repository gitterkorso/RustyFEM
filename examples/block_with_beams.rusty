# Two materials: aluminium block with steel beams (B33) along the block's top edges.
# The beams follow the edge over several nodes, so their rotation is controlled by the block.
material steel
material alu E=70e9 nu=0.33 rho=2700
box x=0..0.4 y=0..0.4 z=0..0.1 size=0.05 material=alu
beam (0,0,0.1) (1.4,0,0.1) section=circle(0.02) n=28 material=steel
beam (0,0.4,0.1) (1.4,0.4,0.1) section=general(1e-3,2e-6,5e-7,1e-6) n=28 up=(0,1,1) material=steel
truss (1.4,0,0.1) (1.4,0.4,0.1) area=1e-4 material=steel
fix x=0
load at=(1.4,0,0.1) fz=-500 mx=20 my=-30
load at=(1.4,0.4,0.1) fy=200 fz=-500
