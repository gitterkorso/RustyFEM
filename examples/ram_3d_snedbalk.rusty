# 3D-ram med sneda balkar, egen orientering och moment kring alla axlar.
material steel
beam (0,0,0) (1,0.5,2) (2,1.5,2.5) section=rect(0.06,0.12) n=5 up=(0,0,1)
beam (2,1.5,2.5) (3,0,0) section=ibeam(0.2,0.1,0.008,0.006) n=6 up=(1,1,0)
beam (1,0.5,2) (3,0,0) section=pipe(0.05,0.004) n=4
fix at=(0,0,0)
pin at=(3,0,0)
load at=(2,1.5,2.5) fx=2e3 fy=-1e3 fz=-5e3 mx=300 my=-200 mz=100
